{
  "name": "unghosted",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:candidate": "bun run --cwd packages/candidate-app dev",
    "build:candidate": "bun run --cwd packages/candidate-app build",
    "lint:candidate": "bun run --cwd packages/candidate-app lint",
    "dev:interviewer": "bun run --cwd packages/interviewer-app dev",
    "build:interviewer": "bun run --cwd packages/interviewer-app build",
    "lint:interviewer": "bun run --cwd packages/interviewer-app lint"
  },
  "trustedDependencies": [
    "electron",
    "koffi"
  ]
}
