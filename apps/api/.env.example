# Copy to apps/api/cmd/server/.env and fill in. Never commit the real file.
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_MINUTES=10080
ADMIN_WEB_ORIGIN=http://localhost:5173

# Either DATABASE_URL, or the POSTGRES_* parts below
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=unghosted
POSTGRES_PASSWORD=unghosted
POSTGRES_DB=unghosted
POSTGRES_SSLMODE=disable
