# WS base URL for the room channel (video call + monitoring event stream), used by the
# renderer directly — see packages/shared/src/roomChannel.ts.
VITE_WS_BASE_URL=ws://localhost:3000

# TURN credentials (Metered) for the video call — see packages/shared/src/useTurnCredentials.ts.
# Leave unset to fall back to STUN-only (works on most networks, fails behind symmetric NAT /
# strict corporate firewalls).
VITE_TURN_DOMAIN=
VITE_TURN_API_KEY=
