VITE_API_BASE_URL=http://localhost:3000

# WS room channel URL is derived from VITE_API_BASE_URL above (http(s) -> ws(s)) — see
# packages/shared/src/roomChannel.ts. No separate WS env var needed.

# TURN credentials (Metered) for the video call — see packages/shared/src/useTurnCredentials.ts.
# Leave unset to fall back to STUN-only (works on most networks, fails behind symmetric NAT /
# strict corporate firewalls).
VITE_TURN_DOMAIN=
VITE_TURN_API_KEY=

# Metered publishable key — used by @metered-ca/realtime for WebRTC peer
# discovery, signaling, and TURN credential delivery.
VITE_METERED_API_KEY=
